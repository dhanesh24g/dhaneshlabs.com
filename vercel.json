{
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "apps.dhaneshlabs.com"
        }
      ],
      "dest": "/apps.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "apps.dhaneshlabs.com"
        }
      ],
      "dest": "/apps.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "tools.dhaneshlabs.com"
        }
      ],
      "dest": "/tools.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tools.dhaneshlabs.com"
        }
      ],
      "dest": "/tools.html"
    },
    {
      "src": "/studio",
      "dest": "/studio.html"
    },
    {
      "src": "/products/league-ledger",
      "dest": "/products/league-ledger.html"
    },
    {
      "src": "/products/code-assistant",
      "dest": "/products/code-assistant.html"
    },
    {
      "src": "/products/dashboard-pro",
      "dest": "/products/dashboard-pro.html"
    },
    {
      "src": "/products",
      "dest": "/products.html"
    },
    {
      "src": "/apps",
      "dest": "/apps.html"
    },
    {
      "src": "/tools",
      "dest": "/tools.html"
    },
    {
      "src": "/content",
      "dest": "/content.html"
    },
    {
      "src": "/travel",
      "dest": "/travel.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/index.html",
      "dest": "/"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
