{
  "builds": [
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "apps.dhaneshlabs.com" }],
      "dest": "/apps/$1"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "tools.dhaneshlabs.com" }],
      "dest": "/tools/$1"
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
