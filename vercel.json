{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/apps",
      "dest": "/apps/index.html"
    },
    {
      "src": "/tools",
      "dest": "/tools/index.html"
    },
    {
      "src": "/content",
      "dest": "/content/index.html"
    },
    {
      "src": "/travel",
      "dest": "/travel/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}